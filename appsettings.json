{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "MicroserviceApp"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catchall}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "RegisteredUser",
        "Match": {
          "Path": "/api/order/{**catchall}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5100" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5012" }
        }
      }
    }
  }, // <-- Tanda kurung kurawal penutup ReverseProxy dipindah ke sini

  "ConnectionStrings": {
    "AuthMsvDBConnection": "Server=localhost; Database=AuthMsvDB; User Id=postgres; Password=postgres; Port=5432; Pooling=true;"
  },
  "RabbitMqSettings": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "AllowedHosts": "*"
}
